{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mairushro",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_modules",
    "enable_nodejs_http_server_modules"
  ],
  "keep_vars": true,
  "vars": {
    "CLOUDFLARE_WORKERS": "1",
    "NODE_ENV": "production"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/dashboard",
      "/auth/*",
      "/api/*",
      "/logout",
      "/health"
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
